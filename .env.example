# Copia este fichero a .env (raíz) y a apps/web/.env.local y rellena los valores.
# Nunca subas los valores reales al repositorio.

# --- Supabase ---
# URL y clave pública (anon/publishable). Con Supabase local: `pnpm exec supabase start` las muestra.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo en el servidor (rutas /api y la ingesta). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres para la ingesta.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- IA (API de Claude) ---
# Sin clave, las funciones de IA responden con un error claro y el resto de la app funciona.
ANTHROPIC_API_KEY=
# Modelo para extracción y clasificación (opcional; por defecto el de apps/web/src/server/ai/client.ts).
ANTHROPIC_MODEL=

# --- Ingesta ---
INGEST_USER_AGENT=ComparaCompraBot/0.1 (+https://github.com/carlosgutierrezmartin/comparacompra)
# Peticiones por minuto por cadena (por defecto 20).
INGEST_RPM_DEFAULT=20
INGEST_RPM_MERCADONA=
INGEST_RPM_CARREFOUR=
INGEST_RPM_DIA=
INGEST_RPM_ALCAMPO=
INGEST_CACHE_DIR=.cache/http
